<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/letter_keyboard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <TextView style="@style/LetterKeyStyle" android:text="Q" />
        <TextView style="@style/LetterKeyStyle" android:text="W" />
        <TextView style="@style/LetterKeyStyle" android:text="E" />
        <TextView style="@style/LetterKeyStyle" android:text="R" />
        <TextView style="@style/LetterKeyStyle" android:text="T" />
        <TextView style="@style/LetterKeyStyle" android:text="Y" />
        <TextView style="@style/LetterKeyStyle" android:text="U" />
        <TextView style="@style/LetterKeyStyle" android:text="I" />
        <TextView style="@style/LetterKeyStyle" android:text="O" />
        <TextView style="@style/LetterKeyStyle" android:text="P" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView style="@style/LetterKeyStyle" android:text="A" />
        <TextView style="@style/LetterKeyStyle" android:text="S" />
        <TextView style="@style/LetterKeyStyle" android:text="D" />
        <TextView style="@style/LetterKeyStyle" android:text="F" />
        <TextView style="@style/LetterKeyStyle" android:text="G" />
        <TextView style="@style/LetterKeyStyle" android:text="H" />
        <TextView style="@style/LetterKeyStyle" android:text="J" />
        <TextView style="@style/LetterKeyStyle" android:text="K" />
        <TextView style="@style/LetterKeyStyle" android:text="L" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/letter_key_clear"
            style="@style/LetterKeyActionStyle"
            android:layout_width="0dp"
            android:layout_weight="1.4"
            android:text="@string/letter_key_clear" />

        <TextView style="@style/LetterKeyStyle" android:text="Z" />
        <TextView style="@style/LetterKeyStyle" android:text="X" />
        <TextView style="@style/LetterKeyStyle" android:text="C" />
        <TextView style="@style/LetterKeyStyle" android:text="V" />
        <TextView style="@style/LetterKeyStyle" android:text="B" />
        <TextView style="@style/LetterKeyStyle" android:text="N" />
        <TextView style="@style/LetterKeyStyle" android:text="M" />

        <ImageView
            android:id="@+id/letter_key_backspace"
            style="@style/LetterKeyActionStyle"
            android:layout_width="0dp"
            android:layout_weight="1.4"
            android:contentDescription="@string/letter_key_backspace"
            android:padding="10dp"
            android:src="@drawable/ic_clear_outline_vector" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/letter_key_space"
            style="@style/LetterKeyActionStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/letter_key_space" />

        <TextView
            android:id="@+id/letter_key_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="0.45"
            android:background="@drawable/letter_search_button_background"
            android:gravity="center"
            android:text="@string/letter_key_search"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
